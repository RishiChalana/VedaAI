# Google Gemini API key — required for AI question extraction & answer mapping.
# Get one (free tier available) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model (defaults to gemini-2.5-flash).
# Note: pro-tier models (gemini-2.5-pro / gemini-3.1-pro-preview) are NOT available
# on the Gemini free tier, so flash is the only free-tier-viable choice.
GEMINI_MODEL=
